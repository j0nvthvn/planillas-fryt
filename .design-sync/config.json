  "dtsPropsFor": {
    "DeltaBadge": "  /** Cifra del período actual. */\n  actual: number;\n  /** Cifra del período anterior; sin dato (`null`/`undefined`) no se muestra nada. */\n  anterior: number | null | undefined;\n  /** Con fondo: píldora sobre la tarjeta, en vez de texto suelto. */\n  fondo?: boolean;\n  /** En gastos, bajar es la buena noticia: se da vuelta solo el color. */\n  menosEsMejor?: boolean;",
    "EsqueletoPagina": "  // No recibe props."
  },
  "extraEntries": [
    "./.design-sync/proveedor.tsx"
  ],
  "provider": {
    "component": "ProveedorPreview"
  },
  "overrides": {
