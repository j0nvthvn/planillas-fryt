# El modo del tubo de maquetas: un Supabase que no existe. El renderizador
# intercepta todas las llamadas a este origen y las contesta desde
# maquetas/datos.mjs, así que acá no hay ningún secreto — y si algo se
# escapara de la interceptación, no llegaría a ninguna base real.
VITE_SUPABASE_URL=https://maquetas.supabase.co
VITE_SUPABASE_ANON_KEY=maqueta-sin-valor
